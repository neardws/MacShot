---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCopy } from '@/i18n/ui';

const locale = 'en';
const t = getCopy(locale);
---

<BaseLayout t={t} locale={locale} subpath="docs">
  <Nav t={t} locale={locale} />
  <main id="main" class="section-pad">
    <div class="wrap max-w-narrow">
      <h1 class="h2">Documentation</h1>
      <p class="mt-4 text-mb-fg2">
        User guides (EN + 中文) will sync from <code class="text-sm">Docs/guide/</code> in the
        Octoshot repository—the same Markdown bundled in the in-app Help window.
      </p>
      <p class="mt-4 text-mb-fg2">
        Until that content lands on <code class="text-sm">main</code>, see
        <a class="link" href="https://github.com/neardws/Octoshot/blob/main/README.md">README</a>
        and <a class="link" href="https://github.com/neardws/Octoshot/tree/main/Docs">Docs/</a> on GitHub.
      </p>
    </div>
  </main>
  <Footer t={t} locale={locale} />
</BaseLayout>
