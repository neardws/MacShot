---
import '@/styles/global.css';
import type { LandingCopy, Locale } from '@/i18n/ui';
import { assets } from '@/config/assets';
import { CDN_BASE } from '@/config/assets';
import { hreflangLocales, localePageUrl } from '@/utils/seo';

interface Props {
  t: LandingCopy;
  locale: Locale;
  /** Path after locale, e.g. `docs` */
  subpath?: string;
}

const { t, locale, subpath = '' } = Astro.props;
const canonical = localePageUrl(locale, subpath);
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.metaDescription} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {
      hreflangLocales.map(({ locale: loc, hreflang }) => (
        <link rel="alternate" hreflang={hreflang} href={localePageUrl(loc, subpath)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localePageUrl('en', subpath)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={assets.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={assets.ogImage} />
    <link rel="preconnect" href={CDN_BASE} crossorigin />
    <title>{t.metaTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <slot />
  </body>
</html>
