---
import type { LandingCopy, Locale } from '@/i18n/ui';
import MascotArt from '@/components/MascotArt.astro';
import {
  availableGalleryScreenshots,
  screenshotSrcSet,
  screenshotWebSrc,
  type ScreenshotStem,
} from '@/lib/screenshots';
import Reveal from './Reveal.astro';

interface Props {
  t: LandingCopy;
  locale: Locale;
}

const { t, locale } = Astro.props;
const shots = availableGalleryScreenshots(locale);

const labels: Record<ScreenshotStem, string> = {
  hero: 'Hero',
  'capture-modebar': t.galleryShotCapture,
  'quick-access-stack': t.galleryShotQuickAccess,
  annotate: t.galleryShotAnnotate,
  'settings-shortcuts': t.galleryShotSettings,
  ocr: t.galleryShotOcr,
};
---

<section class="section-pad bg-mb-bg-alt" id="gallery">
  <div class="wrap mb-10 text-center">
    <Reveal>
      <MascotArt variant="frame" width={72} height={72} class="mx-auto mb-4" />
      <h2 class="h2">{t.galleryTitle}</h2>
      <p class="mx-auto mt-4 max-w-narrow text-mb-fg2">{t.galleryLead}</p>
    </Reveal>
  </div>
  <div
    class="flex gap-5 overflow-x-auto scroll-smooth px-[max(22px,env(safe-area-inset-left))] pb-4 snap-x snap-mandatory"
  >
    {
      shots.map((name, index) => (
        <div
          class="min-w-[min(85vw,420px)] max-w-[420px] shrink-0 snap-center overflow-hidden rounded-shot border border-mb-hair bg-mb-tile-on-alt shot-frame"
        >
          <div class="relative aspect-[16/10] w-full bg-mb-tile">
            <img
              src={screenshotWebSrc(locale, name)}
              srcset={screenshotSrcSet(locale, name)}
              sizes="420px"
              alt={labels[name]}
              width="420"
              height="263"
              class="absolute inset-0 h-full w-full object-cover"
              loading="eager"
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </div>
          <div class="border-t border-mb-hair px-4 py-3 text-center">
            <p class="text-sm font-medium text-mb-fg">{labels[name]}</p>
            <p class="mt-1.5 text-xs font-semibold leading-snug text-mb-brand-red">
              {t.galleryQuips[name]}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
