---
import type { LandingCopy, Locale } from '@/i18n/ui';
import { screenshotSrcSet, screenshotWebSrc } from '@/lib/screenshots';

interface Props {
  t: LandingCopy;
  locale: Locale;
}

const { t, locale } = Astro.props;
const src = screenshotWebSrc(locale, 'hero');
const srcset = screenshotSrcSet(locale, 'hero');
---

<div class="hero-desk mx-auto mt-16 max-w-[min(100%,920px)]">
  <div class="shot-frame overflow-hidden rounded-shot bg-mb-tile shadow-shot">
    <div class="relative aspect-[16/10] bg-mb-bg-alt">
      <img
        src={src}
        srcset={srcset}
        sizes="(min-width: 920px) 920px, 100vw"
        alt={t.heroScreenshotAlt}
        width="920"
        height="575"
        class="h-full w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</div>
