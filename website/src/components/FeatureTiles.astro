---
import type { LandingCopy } from '@/i18n/ui';
import Reveal from './Reveal.astro';

interface Props {
  t: LandingCopy;
}

const { t } = Astro.props;

const icons = [
  'M4 16l4-8 4 4 8-10 4 6',
  'M13 3l7 7-7 7M6 10h14',
  'M12 3v4M12 17v4M3 12h4M17 12h4',
  'M4 6h16v12H4z',
  'M12 8v8M8 12h8',
];
---

<section class="section-pad" id="features">
  <div class="wrap">
    <Reveal>
      <h2 class="h2 text-center">{t.tilesTitle}</h2>
      <p class="mx-auto mt-4 max-w-narrow text-center text-mb-fg2">{t.tilesLead}</p>
    </Reveal>
    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        t.tiles.map((tile, i) => (
          <Reveal
            class:list={[
              'min-h-[300px] rounded-tile bg-mb-tile p-9',
              tile.wide ? 'md:col-span-2' : '',
            ]}
            delay={i * 80}
          >
            <svg
              class="mb-6 h-10 w-10 text-mb-link"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d={icons[i] ?? icons[0]} stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3 class="text-[24px] font-semibold tracking-tight">{tile.title}</h3>
            <p class="mt-3 text-mb-fg2">{tile.body}</p>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
