---
import type { LandingCopy } from '@/i18n/ui';
import MascotArt from '@/components/MascotArt.astro';
import Reveal from './Reveal.astro';

interface Props {
  t: LandingCopy;
}

const { t } = Astro.props;
---

<section class="section-pad" id="features">
  <div class="wrap">
    <Reveal>
      <div class="flex flex-col items-center gap-4 text-center">
        <MascotArt size={88} />
        <h2 class="h2">{t.tilesTitle}</h2>
        <p class="mx-auto max-w-narrow text-mb-fg2">{t.tilesLead}</p>
      </div>
    </Reveal>
    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        t.tiles.map((tile, i) => (
          <Reveal
            class:list={[
              'min-h-[300px] rounded-tile bg-mb-tile p-9',
              tile.wide ? 'md:col-span-2' : '',
            ]}
            delay={i * 80}
          >
            <MascotArt size={56} class="mb-4" />
            <p class="text-[15px] font-semibold leading-snug text-mb-brand-red">{tile.quip}</p>
            <h3 class="mt-3 text-[24px] font-semibold tracking-tight">{tile.title}</h3>
            <p class="mt-3 text-mb-fg2">{tile.body}</p>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
