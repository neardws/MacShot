---
export type MascotVariant = 'intro' | 'frame' | 'busy' | 'done';

interface Props {
  variant: MascotVariant;
  class?: string;
  width?: number;
  height?: number;
}

const { variant, class: className, width = 200, height = 200 } = Astro.props;
const src = `${import.meta.env.BASE_URL}brand/mascot/${variant}.svg`;
---

<img
  src={src}
  alt=""
  width={width}
  height={height}
  class:list={['mascot-art select-none', className]}
  decoding="async"
  draggable="false"
/>
