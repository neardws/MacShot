---
import BrandMark from '@/components/BrandMark.astro';

interface Props {
  class?: string;
  /** Square display size in CSS pixels (matches header logo art). */
  size?: number;
  width?: number;
  height?: number;
  priority?: boolean;
}

const { class: className = '', size, width, height, priority = false } = Astro.props;
const dimension = size ?? width ?? height ?? 200;
---

<BrandMark size={dimension} priority={priority} class:list={['mascot-art', className]} />
