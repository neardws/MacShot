---
import { assets } from '@/config/assets';

interface Props {
  size: number;
  priority?: boolean;
  class?: string;
}

const { size, priority = false, class: className = '' } = Astro.props;
---

<picture class:list={['brand-mark inline-block', className]}>
  <img
    src={assets.logo512}
    alt=""
    width={size}
    height={size}
    class="brand-mark__img rounded-[22%]"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    onerror={`this.onerror=null;this.src='${assets.logoSvg}'`}
  />
</picture>

<style>
  .brand-mark {
    line-height: 0;
  }
  .brand-mark__img {
    box-shadow:
      0 0 0 1px var(--hair),
      0 0 0 3px color-mix(in srgb, var(--brand-red) 35%, transparent);
  }
</style>
