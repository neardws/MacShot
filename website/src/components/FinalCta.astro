---
import BrandMark from '@/components/BrandMark.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import type { LandingCopy } from '@/i18n/ui';
import Reveal from './Reveal.astro';

interface Props {
  t: LandingCopy;
}

const { t } = Astro.props;
---

<section class="section-pad bg-mb-bg-alt text-center">
  <div class="wrap">
    <Reveal>
      <BrandMark size={72} class="mx-auto mb-6" />
      <h2 class="h2">{t.finalTitle}</h2>
      <p class="mx-auto mt-4 max-w-narrow text-mb-fg2">{t.finalLead}</p>
      <DownloadButton label={t.finalCta} class="mt-10" />
    </Reveal>
  </div>
</section>
