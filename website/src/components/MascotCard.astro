---
import type { MascotCardCopy } from '@/i18n/ui';
import MascotArt from '@/components/MascotArt.astro';

interface Props {
  card: MascotCardCopy;
}

const { card } = Astro.props;

const rows: { label: string; value: string }[] = [
  { label: card.labelName, value: card.name },
  { label: card.labelSpecies, value: card.species },
  { label: card.labelPersonality, value: card.personality },
  { label: card.labelCatchphrase, value: card.catchphrase },
  { label: card.labelRole, value: card.role },
];
---

<aside
  class="mascot-card rounded-tile border border-mb-hair bg-mb-tile p-6 text-left shadow-sm md:p-7"
  aria-label={card.ariaLabel}
>
  <div class="flex items-start gap-4">
    <MascotArt variant="frame" width={72} height={72} class="shrink-0" />
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wide text-mb-fg2">{card.cardTitle}</p>
      <p class="mt-1 text-[22px] font-semibold leading-tight text-mb-fg">{card.name}</p>
    </div>
  </div>
  <dl class="mt-5 space-y-3 text-[15px]">
    {
      rows.slice(1).map((row) => (
        <div>
          <dt class="font-semibold text-mb-fg">{row.label}</dt>
          <dd class="mt-0.5 text-mb-fg2">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</aside>
