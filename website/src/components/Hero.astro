---
import BrandMark from '@/components/BrandMark.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import HeroDesk from '@/components/HeroDesk.astro';
import HeroWaves from '@/components/HeroWaves.astro';
import type { LandingCopy, Locale } from '@/i18n/ui';
import { REPO_URL } from '@/i18n/ui';

interface Props {
  t: LandingCopy;
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<section class="section-pad relative pt-24 md:pt-28">
  <HeroWaves />
  <div class="wrap text-center">
    <p class="hero-rise text-[19px] font-semibold text-mb-fg2" style="--i: 0">
      {t.heroEyebrow}
    </p>
    <div class="hero-rise mx-auto mt-6 mb-4" style="--i: 1">
      <BrandMark size={112} priority />
    </div>
    <p class="hero-rise text-[19px] font-semibold text-mb-fg" style="--i: 2">Octoshot</p>
    <h1
      class="hero-rise mx-auto mt-4 max-w-content text-[clamp(44px,7.4vw,80px)] font-semibold leading-[1.05] tracking-[var(--ls-hero)] text-mb-fg"
      style="--i: 3"
    >
      {t.heroTitle}
    </h1>
    <p
      class="hero-rise mx-auto mt-6 max-w-narrow text-[clamp(19px,2vw,21px)] font-semibold text-mb-fg3"
      style="--i: 4"
    >
      {t.heroLead}
    </p>
    <div class="hero-rise mt-10 flex flex-wrap items-center justify-center gap-4" style="--i: 5">
      <DownloadButton label={t.heroCta} />
      <a class="link text-[17px] font-semibold" href={REPO_URL}>{t.heroSecondary} ›</a>
    </div>
    <p class="hero-rise mt-6 text-sm text-mb-fg2" style="--i: 6">{t.heroFine}</p>
    <div class="hero-rise" style="--i: 7">
      <HeroDesk t={t} locale={locale} />
    </div>
  </div>
</section>
